            <span id="serialText" style="color:#8e8e93;font-family:monospace;filter:blur(5px);">LMN-PW1-994920X</span>
          </div>
        </div>
        <div class="ios-card">
          <div class="ios-row"><span>LOCK SCREEN</span><button onclick="lockPhone()" style="color:var(--ios-blue);font-weight:600;">LOCK NOW ›</button></div>
          <div class="ios-row"><span>WI-FI</span><span style="color:#8e8e93;">ZAIN 4.5G+ ›</span></div>
          <div class="ios-row"><span>BLUETOOTH</span><span style="color:#8e8e93;">ON ›</span></div>
          <div class="ios-row"><span>BATTERY HEALTH</span><span style="color:#30d158;font-weight:600;">100%</span></div>
        </div>`;

    case "Calculator":
      return `
        <div style="display:flex;flex-direction:column;justify-content:flex-end;height:100%;">
          <input id="calcOut" value="0" readonly style="width:100%;text-align:right;font-size:48px;font-weight:300;padding:8px 6px 20px;color:#fff;">
          <div class="calc-pad">
            ${["AC","±","%","÷","7","9","4","×","5","6","−","1","2","3","+","0",".","="].map(k => {
              const isFn = ["AC","±","%"].includes(k);
              const isOp = ["÷","×","−","+","="].includes(k);
              const zeroSpan = k === "0" ? "grid-column:span 2;aspect-ratio:auto;border-radius:22px;justify-content:flex-start;padding-left:28px;" : "";
              return `<button class="calc-key ${isFn?"fn":""} ${isOp?"op":""}" style="${zeroSpan}" onclick="runCalc('${k}')">${formatOSString(k)}</button>`;
            }).join("")}
          </div>
        </div>`;

    case "Notes":
      const saved = localStorage.getItem("lumeos_notes") || "";
      return `
        <div class="ios-card" style="min-height:70vh;display:flex;flex-direction:column;">
          <div style="font-size:11px;color:#8e8e93;margin-bottom:8px;">ICLOUD NOTES · LUMEOS 28.2</div>
          <textarea oninput="localStorage.setItem('lumeos_notes', this.value)" placeholder="WRITE A NOTE..." style="flex:1;width:100%;resize:none;font-size:15px;line-height:1.5;">${escapeStr(formatOSString(saved))}</textarea>
        </div>`;

    case "Weather":
      return `
        <div style="background:linear-gradient(180deg,#3b5984,#1f324d);color:#fff;border-radius:26px;padding:28px 20px;text-align:center;margin-bottom:16px;">
          <div style="font-size:21px;font-weight:500;">BAGHDAD</div>
          <div style="font-size:66px;font-weight:200;line-height:1.05;">26°</div>
          <div style="font-size:14px;opacity:0.92;">CLOUDY</div>
          <div style="font-size:12.5px;opacity:0.78;margin-top:4px;">H: 29° L: 16°</div>
        </div>
        <div class="ios-card">
          <div style="font-size:11px;font-weight:600;color:#8e8e93;margin-bottom:8px;">5-DAY FORECAST</div>
          <div class="ios-row"><b>TODAY</b><span>☁️</span><span>16° — 29°</span></div>
          <div class="ios-row"><b>MONDAY</b><span>☀️</span><span>17° — 29°</span></div>
          <div class="ios-row"><b>TUESDAY</b><span>⛅</span><span>15° — 26°</span></div>
        </div>`;

    case "Camera":
      return `
        <div style="display:flex;flex-direction:column;align-items:center;gap:18px;padding-top:10px;">
          <div style="width:100%;height:56vh;border-radius:28px;background:radial-gradient(circle at center,#2c2c2e,#09090b);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#8e8e93;">
            <span style="font-size:32px;">📷</span>
            <span style="font-size:12px;">LC PURA WIDE 50MP VIEWFINDER</span>
          </div>
          <button onclick="cameraFlashEffect()" style="width:68px;height:68px;border-radius:22px;border:4px solid #fff;background:rgba(255,255,255,0.22);"></button>
        </div>`;

    case "Safari":
      return `
        <div class="ios-card">
          <div style="display:flex;gap:8px;align-items:center;background:#e5e5ea;padding:10px 14px;border-radius:14px;">
            <span>🔒</span>
            <input id="safariUrl" placeholder="SEARCH OR ENTER WEBSITE NAME" style="flex:1;font-size:13.5px;" onkeydown="if(event.key==='Enter') launchSafariUrl()">
            <button onclick="launchSafariUrl()" style="color:var(--ios-blue);font-weight:600;">GO</button>
          </div>
        </div>`;

    case "Messages":
      return `
        <div class="ios-card" id="msgThread" style="min-height:54vh;display:flex;flex-direction:column;gap:8px;">
          <div style="align-self:flex-start;background:#e9e9eb;color:#000;padding:10px 14px;border-radius:18px;max-width:76%;font-size:13.5px;">LUMEOS 28.2 MESSAGES READY.</div>
        </div>
        <div style="display:flex;gap:8px;">
          <input id="msgBox" placeholder="IMESSAGE" style="flex:1;background:#fff;padding:12px 16px;border-radius:20px;border:1px solid #d1d1d6;">
          <button onclick="postMessage()" style="width:42px;height:42px;border-radius:14px;background:var(--ios-blue);color:#fff;font-weight:700;">↑</button>
        </div>`;

    case "Photos":
      return `
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;">
          ${[
            "linear-gradient(135deg,#5e5ce6,#0a84ff)",
            "linear-gradient(135deg,#ff375f,#ff9f0a)",
            "linear-gradient(135deg,#30d158,#0a84ff)",
            "linear-gradient(135deg,#bf5af2,#ff375f)",
            "linear-gradient(135deg,#64d2ff,#5e5ce6)",
            "linear-gradient(135deg,#ffd60a,#ff453a)"
          ].map(g => `<div style="aspect-ratio:1/1;border-radius:12px;background:${g};"></div>`).join("")}
        </div>`;

    default:
      return `<div class="ios-card"><h3>${labelUpper}</h3><p style="color:#8e8e93;margin-top:6px;">LUMEOS 28.2 NATIVE VIEW</p></div>`;
  }
}

/* App Helpers */
function pressDialKey(d) {
  if (dialedDigits.length < 15) {
    dialedDigits += d;
    const el = $("dialDisplay");
    if (el) el.textContent = formatOSString(dialedDigits);
  }
}
function backspaceDial() {
  dialedDigits = dialedDigits.slice(0, -1);
  const el = $("dialDisplay");
  if (el) el.textContent = formatOSString(dialedDigits);
}
function triggerCallSim() {
  const el = $("dialDisplay");
  if (el) el.textContent = dialedDigits ? formatOSString(`CALLING ${dialedDigits}...`) : "ENTER NUMBER";
}

function toggleSerialBlur() {
  serialVisible = !serialVisible;
  const el = $("serialText");
  if (el) el.style.filter = serialVisible ? "none" : "blur(5px)";
}

let cVal = "0", cMem = null, cOp = null, cClear = false;
function runCalc(k) {
  const out = $("calcOut");
  if (!out) return;
  if (k === "AC") { cVal = "0"; cMem = null; cOp = null; }
  else if (k === "±") { cVal = String(Number(cVal) * -1); }
  else if (k === "%") { cVal = String(Number(cVal) / 100); }
  else if (["÷","×","−","+","="].includes(k) === false) {
    cVal = cClear ? k : (cVal === "0" && k !== "." ? k : cVal + k);
    cClear = false;
  } else if (["÷","×","−","+"].includes(k)) {
    cMem = Number(cVal); cOp = k; cClear = true;
  } else if (k === "=") {
    if (cMem !== null && cOp) {
      const a = cMem, b = Number(cVal);
      cVal = String({ "+": a + b, "−": a - b, "×": a * b, "÷": b === 0 ? "ERROR" : a / b }[cOp]);
      cMem = null; cOp = null; cClear = true;
    }
  }
  out.value = formatOSString(cVal);
}

function postMessage() {
  const box = $("msgBox");
  if (!box || !box.value.trim()) return;
  $("msgThread").innerHTML += `<div style="align-self:flex-end;background:var(--ios-blue);color:#fff;padding:10px 14px;border-radius:18px;max-width:76%;font-size:13.5px;">${escapeStr(formatOSString(box.value))}</div>`;
  box.value = "";
}

function launchSafariUrl() {
  const v = $("safariUrl").value.trim();
  if (!v) return;
  window.open(/^https?:\/\//i.test(v) ? v : "https://www.google.com/search?q=" + encodeURIComponent(v), "_blank");
}

function cameraFlashEffect() {
  const f = $("flashlightGlow");
  f.style.background = "#ffffff";
  f.classList.add("on");
  setTimeout(() => {
    f.classList.remove("on");
    f.style.background = "";
  }, 130);
}

function escapeStr(s) {
  return s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
</script>
</body>
