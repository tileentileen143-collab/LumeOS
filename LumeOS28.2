          <div class="ios-row"><span>WI-FI</span><span style="color:#8e8e93;">ZAIN 4.5G+ ›</span></div>
          <div class="ios-row"><span>BLUETOOTH</span><span style="color:#8e8e93;">ON ›</span></div>
