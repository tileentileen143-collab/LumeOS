    case "Messages":
      return `
        <div class="ios-card" id="msgThread" style="min-height:54vh;display:flex;flex-direction:column;gap:8px;">
          <div style="align-self:flex-start;background:#e9e9eb;color:#000;padding:10px 14px;border-radius:18px;max-width:76%;font-size:13.5px;">LUMEOS 28.2 MESSAGES READY.</div>
