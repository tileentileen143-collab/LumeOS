        <div class="phone-keypad-wrap">
          <div class="phone-number-display" id="dialDisplay"></div>
          <div class="keypad-grid">
            ${[
              ["1",""], ["2","ABC"], ["3","DEF"],
              ["4","GHI"], ["5","JKL"], ["6","MNO"],
              ["7","PQRS"], ["9","WXYZ"], ["0","+"],
              ["*",""], ["#",""], ["",""]
            ].filter(([d]) => d !== "").map(([d, l]) => `
              <button class="key-btn" onclick="pressDialKey('${d}')">
                <span class="key-digit">${formatOSString(d)}</span>
                <span class="key-letters">${l}</span>
              </button>
