/* App Helpers */
function pressDialKey(d) {
  if (dialedDigits.length < 15) {
    dialedDigits += d;
    const el = $("dialDisplay");
    if (el) el.textContent = formatOSString(dialedDigits);
  }
}
function backspaceDial() {
  dialedDigits = dialedDigits.slice(0, -1);
  const el = $("dialDisplay");
  if (el) el.textContent = formatOSString(dialedDigits);
}
function triggerCallSim() {
  const el = $("dialDisplay");
  if (el) el.textContent = dialedDigits ? formatOSString(`CALLING ${dialedDigits}...`) : "ENTER NUMBER";
}

function toggleSerialBlur() {
  serialVisible = !serialVisible;
  const el = $("serialText");
  if (el) el.style.filter = serialVisible ? "none" : "blur(5px)";
}

function postMessage() {
  const box = $("msgBox");
  if (!box || !box.value.trim()) return;
  $("msgThread").innerHTML += `<div style="align-self:flex-end;background:var(--ios-blue);color:#fff;padding:10px 14px;border-radius:18px;max-width:76%;font-size:13.5px;">${escapeStr(formatOSString(box.value))}</div>`;
  box.value = "";
}

function launchSafariUrl() {
  const v = $("safariUrl").value.trim();
  if (!v) return;
  window.open(/^https?:\/\//i.test(v) ? v : "https://www.google.com/search?q=" + encodeURIComponent(v), "_blank");
}

function cameraFlashEffect() {
  const f = $("flashlightGlow");
  f.style.background = "#ffffff";
  f.classList.add("on");
  setTimeout(() => {
    f.classList.remove("on");
    f.style.background = "";
  }, 130);
}

function escapeStr(s) {
  return s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
