          </div>
          <div style="display:flex;justify-content:center;align-items:center;gap:28px;margin-top:14px;">
            <span style="width:52px;"></span>
            <button onclick="triggerCallSim()" style="width:72px;height:72px;aspect-ratio:1/1;border-radius:22px;background:var(--ios-green);display:grid;place-items:center;box-shadow:0 8px 24px rgba(48,209,88,0.4);">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </button>
            <button onclick="backspaceDial()" style="width:52px;height:52px;display:grid;place-items:center;color:rgba(255,255,255,0.75);font-size:20px;">⌫</button>
