<script>
"use strict";

const $ = id => document.getElementById(id);

/* Keep Numbers Intact (e.g. 68, 68500, 68.5) & Add Spaces Only Between Numbers and Normal Words */
function formatOSString(raw) {
  const str = String(raw).toUpperCase();
  return str
    .replace(/([0-9.,]+)(?=[A-Z])/g, "$1 ")
    .replace(/([A-Z])(?=[0-9])/g, "$1 ");
}

/* State */
let activeApp = null;
let homePageIndex = 0;
let ccProgress = 0;
let ncProgress = 0;
let isLocked = true;
let flashlightOn = false;
let mediaPlaying = false;
let serialVisible = false;
let dialedDigits = "";
let recentApps = ["Settings", "Messages", "Safari", "Calculator"];

const APP_LIST = [
  "Settings", "Photos", "WhatsApp", "Camera",
  "App Store", "Notes", "Calculator", "Clock",
  "Instagram", "TikTok", "YouTube", "Reminders",
  "Phone", "Safari", "Messages", "Music", "Weather", "Calendar"
];

const COMING_SOON_APPS = [
  "YouTube", "TikTok", "Instagram", "App Store",
  "WhatsApp", "Music", "Clock", "Reminders"
];

const FOLDER_GROUPS = [
  ["Settings", "WhatsApp", "YouTube", "Camera"],
  ["TikTok", "Instagram", "Notes", "App Store"],
  ["Phone", "Messages", "Safari", "Music"],
  ["Calculator", "Clock", "Weather", "Reminders"]
];

/* Populate App Library Folders with Real Home Screen Icons (4 Apps Each) */
function hydrateAppLibraryFolders() {
  FOLDER_GROUPS.forEach((group, fIdx) => {
    const quad = $(`folderQuad${fIdx}`);
    if (!quad) return;
    quad.innerHTML = group.map(appName => {
      const homeIcon = document.querySelector(`#mainAppGrid .app-item[data-app="${appName}"] .app-squircle, #dock .app-item[data-app="${appName}"] .app-squircle`);
      const inner = homeIcon ? homeIcon.innerHTML : `<span style="font-size:18px;">✦</span>`;
      const bg = homeIcon ? getComputedStyle(homeIcon).background : "#1c1c1e";
      return `
        <div class="lib-quad-item app-item" data-app="${appName}">
          <div class="app-squircle" style="background:${bg};">${inner}</div>
        </div>
      `;
    }).join("");
  });
}

/* Clock Sync */
function syncSystemClock() {
  const now = new Date();
  const timeStr = formatOSString(now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false }));
  const dateStr = formatOSString(now.toLocaleDateString([], { weekday: "long", month: "long", day: "numeric" }));
  const dayStr = formatOSString(now.toLocaleDateString([], { weekday: "long" }));
  const numStr = formatOSString(now.getDate());

  $("statusTime").textContent = timeStr;
  $("ncTime").textContent = timeStr;
  $("ncDate").textContent = dateStr;
  $("lsTime").textContent = timeStr;
  $("lsDate").textContent = dateStr;
  $("calWidgetDay").textContent = dayStr;
  $("calWidgetNum").textContent = numStr;
}
syncSystemClock();
setInterval(syncSystemClock, 1000);

/* =========================================================================
   LOCK SCREEN -> INSTANT UNLOCK (NO APP SHOW ANIMATION)
   ========================================================================= */
function setLockSwipeProgress(p) {
  const clamped = Math.max(0, Math.min(1, p));
  const ls = $("lockScreen");
  ls.style.transformOrigin = "center center";
  ls.style.transform = `translate3d(0, ${(-clamped * 100).toFixed(1)}%, 0)`;
  ls.style.opacity = (1 - clamped).toFixed(3);
}

function unlockWithHarmony(launchAfterApp) {
  isLocked = false;
  const ls = $("lockScreen");
  ls.classList.add("unlocked");
  ls.style.transform = "";
  ls.style.opacity = "";

  const home = $("homeScreen");
  home.style.transform = homePageIndex === 1 ? "translateX(-100vw)" : "";
  home.style.filter = "";
  home.style.opacity = "1";

  if (launchAfterApp) morphOpenApp(launchAfterApp);
}

function lockPhone() {
  snapCloseCC();
  snapCloseNC();
  forceCloseApp();
  closeAppSwitcher();
  isLocked = true;
  const ls = $("lockScreen");
  ls.classList.remove("unlocked");
  ls.style.transform = "";
  ls.style.opacity = "";
}

/* Home Screen Pager */
function setHomePage(idx) {
  homePageIndex = Math.max(0, Math.min(1, idx));
  $("homeScreen").classList.toggle("library-active", homePageIndex === 1);
  $("dot0").classList.toggle("active", homePageIndex === 0);
  $("dot1").classList.toggle("active", homePageIndex === 1);
}

function filterLibraryApps(q) {
  const query = q.trim().toLowerCase();
  const grid = $("libFoldersGrid");
  const list = $("libSearchList");
  if (!query) {
    grid.style.display = "grid";
    list.style.display = "none";
    return;
  }
  grid.style.display = "none";
  list.style.display = "flex";
  list.innerHTML = APP_LIST
    .filter(a => a.toLowerCase().includes(query))
    .map(a => `<div class="ios-row" style="background:rgba(255,255,255,0.12);padding:12px 16px;border-radius:16px;border:none;" onclick="morphOpenApp('${a}')"><b>${formatOSString(a)}</b><span style="color:var(--ios-blue);">OPEN ›</span></div>`)
    .join("");
}

/* =========================================================================
   INSTANT APP OPEN & CLOSE (NO OPEN OR CLOSE ANIMATION)
   ========================================================================= */
function bindAppPressInteractions() {
  document.querySelectorAll(".app-item").forEach(item => {
    let sx = 0, sy = 0, moved = false;

    item.addEventListener("pointerdown", e => {
      if (isLocked) return;
      sx = e.clientX; sy = e.clientY; moved = false;
    });

    item.addEventListener("pointermove", e => {
      if (Math.hypot(e.clientX - sx, e.clientY - sy) > 10) {
        moved = true;
      }
    });

    item.addEventListener("pointerup", e => {
      if (!moved && !isLocked) {
        e.stopPropagation();
        const appName = item.getAttribute("data-app");
        if (appName) morphOpenApp(appName, item);
      }
    });
  });

  document.querySelectorAll(".widget-unit").forEach(unit => {
    const box = unit.querySelector(".widget-box");
    let sx = 0, sy = 0, moved = false;
    unit.addEventListener("pointerdown", e => {
      if (isLocked) return;
      sx = e.clientX; sy = e.clientY; moved = false;
    });
    unit.addEventListener("pointermove", e => {
      if (Math.hypot(e.clientX - sx, e.clientY - sy) > 10) {
        moved = true;
      }
    });
    unit.addEventListener("pointerup", e => {
      if (!moved && !isLocked) {
        e.stopPropagation();
        morphOpenApp(unit.getAttribute("data-launch"), box);
      }
    });
  });
}

hydrateAppLibraryFolders();
bindAppPressInteractions();

function morphOpenApp(name) {
  closeSpotlight();
  closeAppSwitcher();
  activeApp = name;

  recentApps = [name, ...recentApps.filter(a => a !== name)].slice(0, 5);

  const stage = $("appStage");
  const isLight = ["Settings", "Notes", "Safari", "Messages", "Photos"].includes(name);

  stage.classList.toggle("light-theme", isLight);
  $("statusBar").classList.toggle("light-mode", isLight);
  $("homeBarPill").classList.toggle("dark-pill", isLight);

  $("stageTitle").textContent = formatOSString(name);
  $("stageContent").innerHTML = buildAppHTML(name);

  stage.style.display = "flex";
  stage.style.top = "0px";
  stage.style.left = "0px";
  stage.style.width = "100vw";
  stage.style.height = "100dvh";
  stage.style.transform = "none";
  stage.style.borderRadius = "0px";
  stage.style.opacity = "1";
}

function morphCloseApp() {
  const stage = $("appStage");
  stage.style.display = "none";
  stage.style.opacity = "1";
  stage.style.transform = "none";
  stage.style.borderRadius = "0px";
  activeApp = null;
  $("statusBar").classList.remove("light-mode");
  $("homeBarPill").classList.remove("dark-pill");
}

function forceCloseApp() {
  morphCloseApp();
}

/* =========================================================================
   1:1 FINGER-TRACKING CONTROL CENTER & NOTIFICATION CENTER
   ========================================================================= */
function renderCCProgress(p, animate) {
  ccProgress = Math.max(0, Math.min(1, p));
  const cc = $("controlCenter");
  const tiles = cc.querySelectorAll(".cc-tile");

  cc.classList.toggle("active", ccProgress > 0.02);
  cc.style.transition = animate
    ? "backdrop-filter 0.5s var(--spring-fluid), -webkit-backdrop-filter 0.5s var(--spring-fluid), background 0.5s ease"
    : "none";

  const blurPx = (ccProgress * 42).toFixed(1);
  const satPct = (100 + ccProgress * 90).toFixed(0);
  const bgAlpha = (ccProgress * 0.64).toFixed(3);

  cc.style.backdropFilter = `blur(${blurPx}px) saturate(${satPct}%)`;
  cc.style.webkitBackdropFilter = `blur(${blurPx}px) saturate(${satPct}%)`;
  cc.style.background = `rgba(10, 12, 22, ${bgAlpha})`;

  tiles.forEach(tile => {
    const idx = Number(tile.getAttribute("data-stagger") || 0);
    const delayRatio = idx * 0.022;
    const localP = Math.max(0, Math.min(1, (ccProgress - delayRatio) / (1 - delayRatio * 0.65)));

    const ty = (1 - localP) * -40;
    const sc = 0.84 + localP * 0.16;
    const op = Math.min(1, localP * 1.35);

    tile.style.transformOrigin = "center center";
    tile.style.transition = animate
      ? `transform 0.52s var(--spring-fluid) ${idx * 12}ms, opacity 0.34s ease ${idx * 10}ms`
      : "none";
    tile.style.transform = `translate3d(0, ${ty.toFixed(1)}px, 0) scale(${sc.toFixed(3)})`;
    tile.style.opacity = op.toFixed(3);
  });
}

function snapOpenCC() { renderCCProgress(1, true); }
function snapCloseCC() { renderCCProgress(0, true); }

function renderNCProgress(p, animate) {
  ncProgress = Math.max(0, Math.min(1, p));
  const nc = $("notificationCenter");
  const clockBlock = $("ncClockBlock");
  const bottomBar = $("ncBottomBar");
  const cards = nc.querySelectorAll(".nc-stagger");

  nc.classList.toggle("active", ncProgress > 0.02);
  nc.style.transition = animate
    ? "backdrop-filter 0.5s var(--spring-fluid), -webkit-backdrop-filter 0.5s var(--spring-fluid), background 0.5s ease"
    : "none";
  clockBlock.style.transition = animate ? "transform 0.52s var(--spring-fluid), opacity 0.35s ease" : "none";
  bottomBar.style.transition = animate ? "transform 0.52s var(--spring-fluid), opacity 0.35s ease" : "none";

  const blurPx = (ncProgress * 40).toFixed(1);
  const satPct = (100 + ncProgress * 85).toFixed(0);
  const bgAlpha = (ncProgress * 0.58).toFixed(3);

  nc.style.backdropFilter = `blur(${blurPx}px) saturate(${satPct}%)`;
  nc.style.webkitBackdropFilter = `blur(${blurPx}px) saturate(${satPct}%)`;
  nc.style.background = `rgba(8, 10, 18, ${bgAlpha})`;

  const clockY = (1 - ncProgress) * -56;
  const clockScale = 0.88 + ncProgress * 0.12;
  clockBlock.style.transformOrigin = "center center";
  clockBlock.style.transform = `translate3d(0, ${clockY.toFixed(1)}px, 0) scale(${clockScale.toFixed(3)})`;
  clockBlock.style.opacity = Math.min(1, ncProgress * 1.4).toFixed(3);

  cards.forEach(card => {
    const idx = Number(card.getAttribute("data-idx") || 1);
    const offset = idx * 0.05;
    const localP = Math.max(0, Math.min(1, (ncProgress - offset) / (1 - offset)));
    const y = (1 - localP) * -40;
    const s = 0.9 + localP * 0.1;

    card.style.transformOrigin = "center center";
    card.style.transition = animate
      ? `transform 0.52s var(--spring-fluid) ${idx * 22}ms, opacity 0.35s ease ${idx * 16}ms`
      : "none";
    card.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0) scale(${s.toFixed(3)})`;
    card.style.opacity = Math.min(1, localP * 1.35).toFixed(3);
  });

  bottomBar.style.transform = `translate3d(0, ${(1 - ncProgress) * 28}px, 0)`;
  bottomBar.style.opacity = Math.max(0, (ncProgress - 0.25) * 1.4).toFixed(3);
}

function snapOpenNC() { renderNCProgress(1, true); }
function snapCloseNC() { renderNCProgress(0, true); }

renderCCProgress(0, false);
renderNCProgress(0, false);

/* =========================================================================
   CENTERED STACKED APP SWITCHER + CLEAR ALL
   ========================================================================= */
let activeSwitcherIdx = 0;

function openAppSwitcher() {
  forceCloseApp();
  activeSwitcherIdx = 0;
  renderSwitcherStack();
  $("appSwitcher").classList.add("open");
}

function closeAppSwitcher() {
  $("appSwitcher").classList.remove("open");
}

function clearAllRecentApps() {
  recentApps = [];
  activeSwitcherIdx = 0;
  renderSwitcherStack();
}

function renderSwitcherStack() {
  const stage = $("switcherStack");
  if (!recentApps.length) {
    stage.innerHTML = `<div style="text-align:center;color:rgba(255,255,255,0.55);font-size:13px;">NO RECENT APPS</div>`;
    return;
  }

  stage.innerHTML = recentApps.map((appName, i) => {
    const rel = (i - activeSwitcherIdx + recentApps.length) % recentApps.length;
    const isFront = rel === 0;
    const scale = isFront ? 1 : Math.max(0.84, 1 - rel * 0.065);
    const tx = isFront ? 0 : (rel % 2 === 0 ? -14 : 14) * Math.min(rel, 2);
    const ty = isFront ? 0 : rel * 6;
    const zIndex = recentApps.length - rel;
    const opacity = rel > 2 ? 0 : 1 - rel * 0.22;

    return `
      <div class="switcher-card"
           style="z-index:${zIndex};opacity:${opacity.toFixed(2)};transform:translate3d(${tx}px,${ty}px,0) scale(${scale.toFixed(3)});"
           onclick="handleSwitcherCardTap(${i})">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:14px;font-weight:700;">${formatOSString(appName)}</span>
          <span style="font-size:10px;color:rgba(255,255,255,0.55);">LUMEOS 28.2</span>
        </div>
        <div style="flex:1;display:flex;align-items:center;justify-content:center;font-size:42px;">
          ${getAppEmoji(appName)}
        </div>
        <div style="font-size:10.5px;color:rgba(255,255,255,0.6);text-align:center;">
          ${isFront ? "TAP TO OPEN · SWIPE FOR NEXT" : "TAP TO BRING FORWARD"}
        </div>
      </div>
    `;
  }).join("");
}

function handleSwitcherCardTap(idx) {
  if (idx === activeSwitcherIdx) {
    const chosen = recentApps[idx];
    closeAppSwitcher();
    morphOpenApp(chosen);
  } else {
    activeSwitcherIdx = idx;
    renderSwitcherStack();
  }
}

function getAppEmoji(name) {
  const map = {
    Settings: "⚙️", Photos: "🌸", WhatsApp: "💬", Camera: "📷",
    "App Store": "🅰️", Notes: "📝", Calculator: "🧮", Clock: "⏰",
    Instagram: "📸", TikTok: "🎵", YouTube: "▶️", Reminders: "✅",
    Phone: "📞", Safari: "🧭", Messages: "💚", Music: "🎧",
    Weather: "☁️", Calendar: "📅"
  };
  return map[name] || "✦";
}

/* =========================================================================
   MASTER 1:1 POINTER / TOUCH GESTURE ENGINE
   ========================================================================= */
let gestureMode = null;
let gStartX = 0, gStartY = 0, gLastY = 0, gLastTime = 0, gVelocityY = 0;
const osEl = $("os");

osEl.addEventListener("pointerdown", e => {
  if (e.target.closest(".cc-slider-pill")) return;

  gStartX = e.clientX;
  gStartY = e.clientY;
  gLastY = e.clientY;
  gLastTime = performance.now();
  gVelocityY = 0;
  gestureMode = null;

  const w = osEl.clientWidth;
  const h = osEl.clientHeight;

  if (isLocked) {
    if (gStartY > h * 0.45) {
      gestureMode = "lock-unlock";
    }
    return;
  }

  if ($("appSwitcher").classList.contains("open")) {
    gestureMode = "switcher-swipe";
    return;
  }

  if (gStartY < 76 && ccProgress < 0.1 && ncProgress < 0.1) {
    gestureMode = gStartX > w * 0.55 ? "cc-pull" : "nc-pull";
    return;
  }

  if (ccProgress > 0.85) {
    gestureMode = "cc-dismiss";
    return;
  }

  if (ncProgress > 0.85) {
    gestureMode = "nc-dismiss";
    return;
  }

  if (activeApp && gStartY > h - 75) {
    gestureMode = "app-close";
    return;
  }

  if (!activeApp && gStartY > h - 110) {
    gestureMode = "home-up-switcher";
    return;
  }

  if (!activeApp) {
    gestureMode = "home-swipe";
  }
}, { passive: false });

osEl.addEventListener("pointermove", e => {
  if (!gestureMode) return;
  const now = performance.now();
  const dt = Math.max(1, now - gLastTime);
  gVelocityY = (e.clientY - gLastY) / dt;
  gLastY = e.clientY;
  gLastTime = now;

  const dy = e.clientY - gStartY;
  const h = osEl.clientHeight;

  if (gestureMode === "lock-unlock") {
    e.preventDefault();
    const p = Math.max(0, Math.min(1, -dy / (h * 0.42)));
    setLockSwipeProgress(p);
  } else if (gestureMode === "cc-pull") {
    e.preventDefault();
    renderCCProgress(Math.max(0, Math.min(1, dy / (h * 0.42))), false);
  } else if (gestureMode === "cc-dismiss" && dy < -6) {
    e.preventDefault();
    renderCCProgress(Math.max(0, Math.min(1, 1 + dy / (h * 0.4))), false);
  } else if (gestureMode === "nc-pull") {
    e.preventDefault();
    renderNCProgress(Math.max(0, Math.min(1, dy / (h * 0.42))), false);
  } else if (gestureMode === "nc-dismiss" && dy < -6) {
    e.preventDefault();
    renderNCProgress(Math.max(0, Math.min(1, 1 + dy / (h * 0.4))), false);
  }
}, { passive: false });

osEl.addEventListener("pointerup", e => {
  if (!gestureMode) return;
  const dy = e.clientY - gStartY;
  const dx = e.clientX - gStartX;

  if (gestureMode === "lock-unlock") {
    if (-dy > 75 || gVelocityY < -0.45) {
      unlockWithHarmony();
    } else {
      setLockSwipeProgress(0);
    }
  } else if (gestureMode === "cc-pull") {
    if (ccProgress > 0.24 || gVelocityY > 0.4) snapOpenCC();
    else snapCloseCC();
  } else if (gestureMode === "cc-dismiss") {
    if (ccProgress < 0.78 || gVelocityY < -0.4 || Math.abs(dx) > 95) snapCloseCC();
    else snapOpenCC();
  } else if (gestureMode === "nc-pull") {
    if (ncProgress > 0.24 || gVelocityY > 0.4) snapOpenNC();
    else snapCloseNC();
  } else if (gestureMode === "nc-dismiss") {
    if (ncProgress < 0.78 || gVelocityY < -0.4) snapCloseNC();
    else snapOpenNC();
  } else if (gestureMode === "app-close") {
    if (-dy > 80 || gVelocityY < -0.45) {
      morphCloseApp();
    }
  } else if (gestureMode === "home-up-switcher") {
    if (-dy > 70 || gVelocityY < -0.45) openAppSwitcher();
  } else if (gestureMode === "switcher-swipe") {
    if (recentApps.length > 0 && Math.abs(dx) > 45) {
      activeSwitcherIdx = dx < 0
        ? (activeSwitcherIdx + 1) % recentApps.length
        : (activeSwitcherIdx - 1 + recentApps.length) % recentApps.length;
      renderSwitcherStack();
    }
  } else if (gestureMode === "home-swipe") {
    if (dx < -60 && Math.abs(dy) < 60) setHomePage(1);
    else if (dx > 60 && Math.abs(dy) < 60 && homePageIndex === 1) setHomePage(0);
  }

  gestureMode = null;
});

/* Bottom Home Bar Tap */
$("homeBarZone").addEventListener("click", () => {
  if (isLocked) { unlockWithHarmony(); return; }
  if ($("appSwitcher").classList.contains("open")) { closeAppSwitcher(); return; }
  if (ccProgress > 0.5) { snapCloseCC(); return; }
  if (ncProgress > 0.5) { snapCloseNC(); return; }
  if ($("spotlightOverlay").classList.contains("open")) { closeSpotlight(); return; }
  if (activeApp) { morphCloseApp(); return; }
  if (homePageIndex === 1) { setHomePage(0); }
});

/* Control Center Vertical Sliders */
function setupCCSlider(sliderId, fillId, callback) {
  const slider = $(sliderId);
  const fill = $(fillId);
  let active = false;

  const applyPos = clientY => {
    const rect = slider.getBoundingClientRect();
    let pct = ((rect.bottom - clientY) / rect.height) * 100;
    pct = Math.max(6, Math.min(100, pct));
    fill.style.height = `${pct}%`;
    if (callback) callback(pct);
  };

  slider.addEventListener("pointerdown", e => {
    e.stopPropagation();
    active = true;
    slider.setPointerCapture(e.pointerId);
    applyPos(e.clientY);
  });
  slider.addEventListener("pointermove", e => {
    if (active) {
      e.stopPropagation();
      applyPos(e.clientY);
    }
  });
  slider.addEventListener("pointerup", () => { active = false; });
}

setupCCSlider("brightnessSlider", "brightnessFill", pct => {
  const dimOpacity = Math.max(0, (100 - pct) / 100 * 0.65);
  $("brightnessDimmer").style.opacity = dimOpacity.toFixed(3);
